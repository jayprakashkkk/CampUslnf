# CampUs Environment Configuration Template
# Copy this file to .env and update the values:

PORT=8080
SPRING_PROFILES_ACTIVE=prod
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
JPA_DDL_AUTO=update
CAMPUSFIND_OWNER_USERNAME=admin

# Brevo (Sendinblue) SMTP Settings for Password Reset
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your-brevo-login-email-or-smtp-key
MAIL_PASSWORD=your-brevo-smtp-master-key
MAIL_FROM=your-verified-sender@yourdomain.com
MAIL_SENDER_NAME=CampUs | Lost & Found
RESET_OTP_MINUTES=10
