{
  "name": "campus-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor mobile app wrapper for CampUs Lost & Found",
  "scripts": {
    "mobile:prepare": "node mobile/prepare-web.mjs",
    "mobile:sync": "npm run mobile:prepare && cap sync",
    "mobile:add:android": "npm run mobile:prepare && cap add android",
    "mobile:add:ios": "npm run mobile:prepare && cap add ios",
    "mobile:open:android": "cap open android",
    "mobile:open:ios": "cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
