# Railway / Hosted Production Environment Configuration
# When using Railway with a PostgreSQL database, DATABASE_URL is automatically provided!
#
# If you want to configure variables manually, use these:
SPRING_PROFILES_ACTIVE=prod
JPA_DDL_AUTO=update
PORT=8080

# The app automatically connects to Railway Postgres using DATABASE_URL.
# If connecting to an external database (e.g. Neon, Supabase):
# SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=require
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_password

# Trusted owner's lowercase username for bootstrap:
CAMPUSFIND_OWNER_USERNAME=your-username

# Optional Gmail SMTP settings for Password Reset OTP:
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your-gmail@gmail.com
# MAIL_PASSWORD=your-google-app-password
# RESET_OTP_MINUTES=10
