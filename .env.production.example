# Copy these variables into your hosting provider's Environment settings.
# Set SPRING_PROFILES_ACTIVE=prod for PostgreSQL.
SPRING_PROFILES_ACTIVE=prod
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:5432/DATABASE?sslmode=require
SPRING_DATASOURCE_USERNAME=DATABASE_USERNAME
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
JPA_DDL_AUTO=update
PORT=8080

# Set this to the trusted owner's lowercase username before first public launch.
CAMPUSFIND_OWNER_USERNAME=your-owner-username
